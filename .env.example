# 数据库连接：compose 会把这三个变量透传给容器（Spring 原生变量，优先级高于
# application.yaml 中的默认值）；也可改用等价的 DB_URL / DB_USERNAME / DB_PASSWORD
SPRING_DATASOURCE_URL='jdbc:mysql://db.example.com:3306/hrs_blog?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai'
SPRING_DATASOURCE_USERNAME='replace-with-database-user'
SPRING_DATASOURCE_PASSWORD='replace-with-database-password'

# JWT 签名密钥：至少 32 个字符，必须随机生成，禁止复用其他系统的密钥
# 生成方式：openssl rand -base64 48
JWT_SECRET='replace-with-at-least-32-random-characters'
# 访问令牌有效期，默认 2h
JWT_TTL='2h'

# 静态资源：对外链接前缀（留空则返回 /assets/... 站内相对路径）
# 存储目录由 compose 固定为 /app/storage/assets；单文件上限 5MB 与扩展名白名单
# jpg,jpeg,png,webp,gif 固定在 application.yaml 的 hrsblog.storage.max-size / allowed-types
STORAGE_PUBLIC_BASE_URL=''

# 允许跨域的前端地址（逗号分隔）
CORS_ALLOWED_ORIGINS='http://localhost:27080,http://localhost:27081'
