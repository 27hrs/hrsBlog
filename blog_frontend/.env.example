# 访客文章 API（构建期使用）。留空则不请求 API，直接使用已有内容/fixtures。
BLOG_API_BASE=http://localhost:27000/api

# 站点公开地址，用于 canonical / sitemap / RSS。生产构建时改成真实域名。
BLOG_SITE_URL=http://localhost:27080

# 封面 CDN 前缀；留空则使用站内 /assets。
BLOG_ASSET_BASE=

# 1 = API 失败直接让构建失败（生产 CI 建议开启）；
# 0 = API 失败时复用缓存，或回退到 scripts/fixtures。
BLOG_SYNC_STRICT=0

# 可选：限制同步篇数，便于本地调试。
BLOG_CONTENT_LIMIT=

# 单次 API 请求超时（毫秒）。
BLOG_SYNC_TIMEOUT=5000
