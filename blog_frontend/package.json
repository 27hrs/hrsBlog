{
  "name": "hrsblog-blog-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-settings.mjs && node scripts/sync-content.mjs && vitepress dev --port 27080",
    "dev:offline": "node scripts/seed-content.mjs && vitepress dev --port 27080",
    "sync": "node scripts/sync-content.mjs && node scripts/sync-settings.mjs",
    "sync:settings": "node scripts/sync-settings.mjs",
    "seed": "node scripts/seed-content.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "build": "node scripts/sync-settings.mjs && node scripts/sync-content.mjs && node scripts/clean-dist.mjs && vitepress build && node scripts/verify-build.mjs",
    "preview": "vitepress preview --port 27080",
    "verify": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
